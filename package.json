{
  "name": "sonarqube-mcp-fixer",
  "version": "0.1.0",
  "description": "MCP Server for SonarQube and Sentry: reports, fix context aggregation, and AI-assisted remediation workflows.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sonarqube-mcp-fixer": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "MCP_TRANSPORT=http node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js"
  },
  "keywords": [
    "mcp",
    "sonarqube",
    "sentry",
    "code-quality",
    "llm",
    "ai-fix"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
